# Public build-time settings. Restart Metro with --reset-cache after changes.
# Android emulator defaults to http://10.0.2.2:3000; iOS to http://localhost:3000.
# For a physical phone, set your computer's LAN address. Use HTTPS for release.
DENTRA_API_URL=
DENTRA_SUPPORT_EMAIL=support@dentra.in

# Enable after adding the matching Firebase native config files and rebuilding both apps.
DENTRA_PUSH_ENABLED=false
# Turn on for iOS only after Apple signing and Firebase APNs configuration are ready.
DENTRA_PUSH_IOS_ENABLED=false
