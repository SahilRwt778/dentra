NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/dentra

# Comma-separated browser origins allowed to call this API. Defaults to
# dentra-web-admin's dev server port if unset.
CORS_ORIGINS=http://localhost:5174,http://localhost:5175

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

OTP_HASH_SECRET=change-me-too

# SMS delivery is still deferred; verification uses the generated backend code.
SMS_PROVIDER_API_KEY=

# Private patient attachments. Never expose this directory through static hosting.
PATIENT_FILES_DIRECTORY=./uploads/patients
DENTIST_FILES_DIRECTORY=./uploads/dentists

# Use local for development, supabase for Render's ephemeral filesystem.
STORAGE_PROVIDER=local
SUPABASE_URL=
# Backend-only secret key (sb_secret_...). Never use a publishable key or expose this to clients.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=dentra-private

# Razorpay, test mode — Dashboard > Settings > API Keys (Test Mode) and
# Settings > Webhooks > your webhook > Secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Patient push delivery. Requires Firebase credentials and matching mobile configuration.
# Apple delivery additionally requires APNs; Android can be enabled independently.
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
# Absolute path to a server-only service-account JSON file, or use workload identity/ADC in production.
# Never place this key in a mobile app, public web directory, or source control.
GOOGLE_APPLICATION_CREDENTIALS=

# LiveKit Cloud (Build plan works for development) or your own LiveKit server.
# These credentials are SERVER ONLY. Mobile/web apps receive a short-lived room token.
VIDEO_ENABLED=false
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: client-reachable URL when the API accesses a self-hosted server internally.
LIVEKIT_PUBLIC_URL=
# In the LiveKit dashboard, configure https://YOUR-API/video/webhook using this same API key.
